# SENTINEL-X — example environment. Copy to .env and fill in. NEVER commit .env.
# The default configuration runs the full end-to-end slice with NO secrets.

# --- LLM provider selection ---
# "deterministic" (default): offline, rule-based stand-in used for tests and local runs.
# "anthropic": real Claude API (requires SENTINELX_LLM_API_KEY and the [llm] extra).
SENTINELX_LLM_PROVIDER=deterministic

# Only needed when SENTINELX_LLM_PROVIDER=anthropic. Leave empty otherwise.
SENTINELX_LLM_API_KEY=
# Pin the exact model for reproducibility when using a real provider.
SENTINELX_LLM_MODEL=
# Decoding controls recorded in every experiment manifest.
SENTINELX_LLM_TEMPERATURE=0.0
SENTINELX_LLM_SEED=7

# --- Retrieval ---
SENTINELX_RETRIEVAL_TOP_K=5

# --- Database (scaffold only; the default in-memory store needs none of this) ---
# Used by docker-compose and the (not-yet-wired) pgvector adapter.
SENTINELX_DB_HOST=localhost
SENTINELX_DB_PORT=5432
SENTINELX_DB_NAME=sentinelx
SENTINELX_DB_USER=sentinelx
# Set a strong value in your local .env; the compose file reads POSTGRES_PASSWORD.
SENTINELX_DB_PASSWORD=
