# Secrets — never commit
.env
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Evaluation run outputs (manifests are committed selectively; raw results are not)
evals/results/*
!evals/results/.gitkeep

# Local data that is NOT redistributable (downloaded datasets go here, never committed)
data/external/
*.pcap
*.zip

# OS / editor
.DS_Store
.idea/
.vscode/
